# Staging safety settings. Do not put real secrets in this file.
APP_ENV=staging
MONGODB_URI=mongodb+srv://STAGING_USER:STAGING_PASSWORD@YOUR_CLUSTER/
MONGODB_DB=yoga_signup_test
PUSH_MODE=disabled
REMINDER_SCHEDULER_ENABLED=false
STAGING_USERNAME=choose-a-staging-username
STAGING_PASSWORD=choose-a-long-random-password
